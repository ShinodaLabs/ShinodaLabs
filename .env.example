# Google Analytics Google tag ID (example: G-ABC1234)
VITE_SHINODALABS_GA_ID=

# Google Analytics Google tag ID used only by /landing-page-advogados
VITE_LP_ADVOGADOS_GA_ID=

# Google Tag Manager container ID used only by /landing-page-advogados (example: GTM-ABC1234)
VITE_LP_ADVOGADOS_GTM_ID=

# Google Analytics Google tag ID used only by /landing-page-academias
VITE_LP_ACADEMIAS_GA_ID=

# Google Tag Manager container ID used only by /landing-page-academias (example: GTM-ABC1234)
VITE_LP_ACADEMIAS_GTM_ID=

# Optional per-landing GA / GTM (same pattern as above)
VITE_LP_DENTISTAS_GA_ID=
VITE_LP_DENTISTAS_GTM_ID=
VITE_LP_CLINICAS_MEDICAS_GA_ID=
VITE_LP_CLINICAS_MEDICAS_GTM_ID=
